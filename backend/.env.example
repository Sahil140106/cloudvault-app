# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_cloudvault_2026_change_me
JWT_EXPIRES_IN=7d

# AWS Configuration (Get these from AWS Console -> IAM -> Users -> Security Credentials)
# Replace with your real AWS credentials when you are ready to connect to AWS.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# AWS S3 Storage Settings
AWS_S3_BUCKET_NAME=my-cloudvault-storage-bucket

# AWS DynamoDB Database Settings
AWS_DYNAMODB_USERS_TABLE=CloudVault_Users
AWS_DYNAMODB_FILES_TABLE=CloudVault_Files

